# Model providers (set the one named in your eval config)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Langfuse (only when langfuse.enabled: true)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Ragas usage analytics are off unless you change this
RAGAS_DO_NOT_TRACK=true
