# Model providers (set the one named in your eval config). Placeholders only; never commit .env.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional fallback providers (docs/MULTI-PROVIDER-FALLBACK.md). A provider listed in a
# provider_strategy whose variables are empty is skipped and recorded, not used.
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Langfuse (only when langfuse.enabled: true)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Ragas usage analytics are off unless you change this
RAGAS_DO_NOT_TRACK=true
